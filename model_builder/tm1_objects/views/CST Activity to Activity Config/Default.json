"{\"@odata.type\": \"ibm.tm1.api.v1.MDXView\", \"Name\": \"Default\", \"MDX\": \"SELECT\\nNON EMPTY {\\n  STRTOMEMBER(\\\"[GBL Period].[\\\" + [GBL Version].CURRENTMEMBER.PROPERTIES(\\\"Start Period\\\") + \\\"]\\\")\\n  :\\n  STRTOMEMBER(\\\"[GBL Period].[\\\" + [GBL Version].CURRENTMEMBER.PROPERTIES(\\\"End Period\\\") + \\\"]\\\")\\n} ON 0,\\nNON EMPTY {\\n  [CST Activity].[CST Activity].MEMBERS\\n} * {\\n  [CST Activity Dest].[CST Activity Dest].MEMBERS\\n} * {\\n  [GBL Cost Centre].[GBL Cost Centre].MEMBERS\\n} ON 1\\nFROM [CST Activity to Activity Config]\\nWHERE (\\n  [GBL Version].[GBL Version].[Budget],\\n  [CST Activity to Activity Config Measure].[CST Activity to Activity Config Measure].[Driver Value]\\n)\\n\"}"