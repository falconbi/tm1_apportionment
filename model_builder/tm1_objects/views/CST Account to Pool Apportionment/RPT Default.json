"{\"@odata.type\": \"ibm.tm1.api.v1.MDXView\", \"Name\": \"RPT Default\", \"MDX\": \"SELECT\\nNON EMPTY {\\n  STRTOMEMBER(\\\"[GBL Period].[\\\" + [GBL Version].CURRENTMEMBER.PROPERTIES(\\\"Start Period\\\") + \\\"]\\\")\\n  :\\n  STRTOMEMBER(\\\"[GBL Period].[\\\" + [GBL Version].CURRENTMEMBER.PROPERTIES(\\\"End Period\\\") + \\\"]\\\")\\n} ON 0,\\nNON EMPTY {\\n  DRILLDOWNMEMBER(\\n    { [GBL Account].[GBL Account].[TOTAL OVERHEAD] },\\n    { [GBL Account].[GBL Account].[TOTAL OVERHEAD] },\\n    RECURSIVE)\\n} * {\\n  [CST Cost Pool].[CST Cost Pool].MEMBERS\\n} ON 1\\nFROM [CST Account to Pool Apportionment]\\nWHERE (\\n  [GBL Version].[GBL Version].[Forecast],\\n  [CST Account to Pool Apportionment Measure].[CST Account to Pool Apportionment Measure].[Apportioned Amount],\\n  [GBL Cost Centre].[GBL Cost Centre].[Total Cost Centres]\\n)\\n\"}"