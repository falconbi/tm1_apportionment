"{\"@odata.type\": \"ibm.tm1.api.v1.MDXView\", \"Name\": \"RPT Default\", \"MDX\": \"SELECT\\nNON EMPTY {\\n  STRTOMEMBER(\\\"[GBL Period].[\\\" + [GBL Version].CURRENTMEMBER.PROPERTIES(\\\"Start Period\\\") + \\\"]\\\")\\n  :\\n  STRTOMEMBER(\\\"[GBL Period].[\\\" + [GBL Version].CURRENTMEMBER.PROPERTIES(\\\"End Period\\\") + \\\"]\\\")\\n} ON 0,\\nNON EMPTY {\\n  [CST Cost Pool].[CST Cost Pool].MEMBERS\\n} * {\\n  [CST Activity].[CST Activity].MEMBERS\\n} ON 1\\nFROM [CST Pool to Activity Apportionment]\\nWHERE (\\n  [GBL Version].[GBL Version].[Budget],\\n  [CST Pool to Activity Apportionment Measure].[CST Pool to Activity Apportionment Measure].[Apportioned Amount],\\n  [GBL Cost Centre].[GBL Cost Centre].[Total Cost Centres]\\n)\\n\"}"