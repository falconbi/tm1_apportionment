"{\"@odata.type\": \"ibm.tm1.api.v1.MDXView\", \"Name\": \"RPT Stage 1b Pool Settled vs Input\", \"MDX\": \"SELECT\\nNON EMPTY {\\n  STRTOMEMBER(\\\"[GBL Period].[\\\" + [GBL Version].CURRENTMEMBER.PROPERTIES(\\\"Start Period\\\") + \\\"]\\\")\\n  :\\n  STRTOMEMBER(\\\"[GBL Period].[\\\" + [GBL Version].CURRENTMEMBER.PROPERTIES(\\\"End Period\\\") + \\\"]\\\")\\n} ON 0,\\nNON EMPTY {\\n  TM1FILTERBYLEVEL({TM1SUBSETALL([CST Cost Pool])}, 0)\\n} * {\\n  [CST Pool to Activity Apportionment Measure].[Amount],\\n  [CST Pool to Activity Apportionment Measure].[Settled Amount],\\n  [CST Pool to Activity Apportionment Measure].[Apportioned Amount]\\n} ON 1\\nFROM [CST Pool to Activity Apportionment]\\nWHERE (\\n  [GBL Version].[GBL Version].[Budget],\\n  [CST Activity].[CST Activity].[Input],\\n  [GBL Cost Centre].[GBL Cost Centre].[Total Cost Centres]\\n)\\n\"}"