"{\"@odata.type\": \"ibm.tm1.api.v1.MDXView\", \"Name\": \"Default\", \"MDX\": \"SELECT\\nNON EMPTY {\\n  STRTOMEMBER(\\\"[GBL Period].[\\\" + [GBL Version].CURRENTMEMBER.PROPERTIES(\\\"Start Period\\\") + \\\"]\\\")\\n  :\\n  STRTOMEMBER(\\\"[GBL Period].[\\\" + [GBL Version].CURRENTMEMBER.PROPERTIES(\\\"End Period\\\") + \\\"]\\\")\\n} ON 0,\\nNON EMPTY {\\n  [CST Activity].[CST Activity].MEMBERS\\n} * {\\n  [CST Driver].[CST Driver].MEMBERS\\n} * {\\n  [CST Service Line].[CST Service Line].MEMBERS\\n} ON 1\\nFROM [CST Activity Config]\\nWHERE (\\n  [GBL Version].[GBL Version].[Budget],\\n  [CST Activity Config Measure].[CST Activity Config Measure].[Activity to Service Line Basis]\\n)\\n\"}"