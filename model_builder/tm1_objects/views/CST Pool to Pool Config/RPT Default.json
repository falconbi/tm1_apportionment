"{\"@odata.type\": \"ibm.tm1.api.v1.MDXView\", \"Name\": \"RPT Default\", \"MDX\": \"SELECT\\nNON EMPTY {\\n  STRTOMEMBER(\\\"[GBL Period].[\\\" + [GBL Version].CURRENTMEMBER.PROPERTIES(\\\"Start Period\\\") + \\\"]\\\")\\n  :\\n  STRTOMEMBER(\\\"[GBL Period].[\\\" + [GBL Version].CURRENTMEMBER.PROPERTIES(\\\"End Period\\\") + \\\"]\\\")\\n} * {\\n  [CST Pool to Pool Config Measure].[CST Pool to Pool Config Measure].MEMBERS\\n} ON 0,\\nNON EMPTY {\\n  TM1FILTERBYLEVEL({TM1SUBSETALL([CST Cost Pool Dest])}, 0)\\n} * {\\n  TM1FILTERBYLEVEL({TM1SUBSETALL([CST Cost Pool])}, 0)\\n} ON 1\\nFROM [CST Pool to Pool Config]\\nWHERE (\\n  [GBL Version].[GBL Version].[Budget],\\n  [GBL Cost Centre].[GBL Cost Centre].[Input]\\n)\\n\"}"